# cpu-mem-overlay v2 example configuration.
#
# Copy this file next to the running cpu-mem-overlay.exe and rename it
# to `cpu-mem-overlay.toml`. Every key is optional; omit a key to use
# its default. A missing file, an unparseable file, or any single
# invalid value silently falls back to the documented default for that
# field — no log, no on-screen error.

# Refresh cadence in milliseconds. Positive integer >= 100. Default: 1000.
refresh_interval_ms = 1000

# Top-left position of the overlay in virtual-screen pixel coordinates [x, y].
# Origin is the primary monitor's top-left; negative values are valid for
# monitors positioned above or to the left of the primary monitor.
# If the resulting window would lie entirely outside every monitor's work
# area, the overlay falls back to the bottom-right of the primary monitor's
# work area.
# Default: (computed at startup) bottom-right of the primary monitor's work area.
# anchor_position = [200, 100]

# RGBA background color. "#RRGGBB" implies alpha = FF (opaque).
# "#RRGGBBAA" sets alpha explicitly; "00" alpha = fully transparent.
# Default: "#00000000" (fully transparent — only the metric text is rendered).
# background_color = "#00000000"

# Font size for both metric lines (logical pixels). Positive number, max 256.
# The window auto-fits to contain both lines without clipping. Default: 14.
font_size = 12

# Allow click-drag to reposition the overlay during the current session.
# Drag positions are NOT persisted; relaunching restores anchor_position
# (or its fallback). Default: false.
draggable = true
